---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { positions } from '../data/positions';
import { disciplines } from '../data/content';

---
<Layout title="Apply to Join" current="join" description="Application information for experienced Penn State University Park students interested in contributing to Planetary Systems Laboratory and Project SUNRISE.">
  <PageIntro title="Join the team" text="We’re seeking University Park students who can demonstrate relevant work, take initiative, and contribute to the Planetary Systems Laboratory." />
  <section class="container article-section"><div class="split"><div><h2>Bring your<br />point of view</h2></div><div><p>Project SUNRISE is an ever evolving rover design, which means the people who join now can help define what SUNRISE becomes. Bring the work that has taught you how to think, build, investigate, and keep going when the answer is not obvious.</p><p>Whether your experience comes from a personal project, research, an internship, fabrication, programming, electronics, or scientific investigation, we want to hear what you’re excited to make possible and what you want to learn alongside the team.</p></div></div><div class="discipline-grid">{disciplines.map(([name,text],i) => <article><span class="index">0{i+1}</span><h3>{name}</h3><p>{text}</p></article>)}</div></section>
  <section class="container article-section"><h2>The application</h2><ol class="application-sections"><li><span class="number">01</span><div><h3>Contact & academic information</h3><p>Full name, Penn State email, campus, major or program, expected graduation, and your intended contribution area.</p><p>Applicants must be enrolled at University Park. Penn State sign-in alone does not establish campus eligibility.</p></div></li><li><span class="number">02</span><div><h3>Your contribution</h3><blockquote>What relevant experience would you bring to Planetary Systems Laboratory, and what do you hope to contribute or learn through Project SUNRISE?</blockquote><p>Aim for 150–300 words. Be specific about your experience and the contribution you hope to make.</p></div></li><li><span class="number">03</span><div><h3>Supporting materials</h3><ul><li>Required: résumé, one PDF up to 10 MB.</li><li>Required: LinkedIn profile URL.</li><li>Optional: portfolio or GitHub URL.</li></ul></div></li></ol></section>
  <section class="container section positions" aria-labelledby="positions-heading">
    <h2 id="positions-heading">Open positions</h2>
    <p class="positions-intro">Find your place at PSL. Specific roles and opportunities will be posted here as the team grows.</p>
    <div class="position-list">
      {positions.map(position => <details class="position">
        <summary><div><h3>{position.title}</h3><p>{position.area} <span aria-hidden="true">·</span> University Park</p></div><span class="position-status">{position.placeholder ? 'Coming soon' : 'View role'} <span class="expand-icon" aria-hidden="true">+</span></span></summary>
        <div class="position-description">
          <p>{position.description}</p>
          <h4>What you’ll work on</h4><p>{position.responsibilities}</p>
          <h4>What we’re looking for</h4><p>{position.qualifications}</p>
          {position.applicationUrl ? <a class="button" href={position.applicationUrl}>Apply for this role ↗</a> : <p class="position-note">This is a placeholder for a future opportunity. Applications are not open for this role.</p>}
        </div>
      </details>)}
    </div>
  </section>
</Layout>

<style>
.positions-intro{max-width:640px;margin-top:24px}
.position-list{margin-top:42px;border-top:1px solid #333}
.position{border-bottom:1px solid #333}
.position summary{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:30px 0;cursor:pointer;list-style:none}
.position summary::-webkit-details-marker{display:none}
.position summary p{margin-top:10px;font-size:.9rem}
.position summary:hover h3{color:#bbb}
.position summary:focus-visible{outline:2px solid white;outline-offset:6px}
.position-status{display:flex;align-items:center;gap:28px;font-size:.75rem;text-transform:uppercase;white-space:nowrap}
.expand-icon{font-size:1.5rem;transition:transform .2s}
.position[open] .expand-icon{transform:rotate(45deg)}
.position-description{max-width:720px;padding:0 0 32px}
.position-description h4{margin:24px 0 8px;text-transform:uppercase;font-size:.85rem}
.position-description .button,.position-note{margin-top:28px}
.position-note{font-size:.85rem;color:#999}
@media(max-width:600px){.position summary{align-items:flex-start;flex-direction:column;gap:18px}.position-status{width:100%;justify-content:space-between}}
</style>